# cleen.cpp -- your local config. Copy this file to ".env" and edit.
#
#     cp .env.example .env       (macOS/Linux)
#     copy .env.example .env     (Windows)
#
# This file is a TEMPLATE and is safe to ship. Your real ".env" is gitignored and
# NEVER leaves your machine. cleen reads keys from the environment (or this .env) at
# runtime -- no key is ever hardcoded in the code. If you set no cloud key at all,
# cleen is happily local-only: free, private, runs on anything.
# ------------------------------------------------------------------------------------

# ====================================================================================
# 1. WHICH BRAIN RUNS BY DEFAULT (routing policy)
# ====================================================================================
# auto  = local-first (free, private, no surprise cloud bills)   <- safe default
# fast  = prefer the fast cloud API, fall back to local if no key / offline
# local = always local        cloud = always cloud
# (You can still override per call with --local / --cloud / --fast, or the
#  X-Cleen-Mode header on the API.)
CLEEN_MODE=auto

# The default catalog model. Ships with three logical names:
#   cleen-coder      (default) Qwen coder  -- fits a 6GB GPU locally
#   cleen-coder-max  Qwen3-Coder MoE       -- bigger, runs from disk if needed
#   cleen-chat       general chat & reasoning
# Or put ANY raw local model id here to bring your own (e.g. llama3.1:8b, mistral, etc.)
CLEEN_MODEL=cleen-coder

# ====================================================================================
# 2. YOUR OWN LOCAL BRAIN  (bring-your-own, runs on your machine -- free & private)
# ====================================================================================
# Point cleen at whatever local runtime you already run. Defaults shown.
#   ollama    = the Ollama HTTP API (default; llama.cpp under the hood)
#   llamacpp  = a llama.cpp `llama-server` (OpenAI-compatible) -- same interface
CLEEN_LOCAL_KIND=ollama
CLEEN_LOCAL_BASE=http://127.0.0.1:11434
# Then pull a model into your runtime, e.g.:  ollama pull qwen2.5-coder:7b
# To use your OWN model instead of the catalog, set CLEEN_MODEL above to its id.

# ====================================================================================
# 3. YOUR OWN CLOUD BRAIN  (bring-your-own provider + key -- fast, opt-in, paid by you)
# ====================================================================================
# Set ANY ONE key below and cleen can burst to that provider for speed. All are
# OpenAI-compatible, so one backend serves them all. Pick order when several are set:
# gemini -> cerebras -> nim -> openrouter -> openai (first with a key wins).
#
# Leave them ALL blank to stay 100% local & free. Never commit your real key.

# Google Gemini -- has a FREE tier, OpenAI-compatible. Preferred first when set.
GEMINI_API_KEY=

# Cerebras -- the ~2,000 tok/s speed tier.
CEREBRAS_API_KEY=

# NVIDIA NIM.
NVIDIA_KEY=

# OpenRouter -- hosts real Qwen3-Coder in the cloud.
OPENROUTER_API_KEY=

# OpenAI.
OPENAI_API_KEY=

# Force ONE provider regardless of pick order (optional): gemini|cerebras|nim|openrouter|openai
# CLEEN_PROVIDER=

# ====================================================================================
# 4. KEEP SECRETS OUT OF THIS TREE (optional, advanced)
# ====================================================================================
# Instead of pasting a key above, point cleen at an EXISTING env file you already keep
# elsewhere. Comma-separate multiple paths. The key stays in that file; only the PATH
# lives here, so the shipped source has neither the key nor a hint of it.
# CLEEN_EXTRA_ENV=/path/to/your/existing/.env
